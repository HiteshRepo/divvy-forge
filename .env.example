# OpenAI API key — consumed by TrueForge (not by divvy-forge Python code directly)
# Source this file before starting TrueForge locally:
#   source .env && npx @truefoundry/trueforge
OPENAI_API_KEY=

# GitHub token scoped to HiteshRepo/stock-screeners
# Required scopes: contents:read+write, pull_requests:write
GITHUB_TOKEN=

# Screener.in session cookie for fetching fundamentals
# Optional — if unset, market-data-fetcher falls back to yfinance only
SCREENER_COOKIE=

# TrueForge instance base URL (default for local mode)
TRUEFORGE_BASE_URL=http://localhost:8790

# TrueForge API key — optional, only needed if auth is enabled on the instance
TRUEFORGE_API_KEY=

# Daytona API key for sandboxed code execution
DAYTONA_API_KEY=

# Agent mode: "single" (default) or "subagent"
#   single   — coordinator does the full analysis itself via MCP tools + bash sandbox.
#              Works with any TrueForge version.
#   subagent — coordinator spawns parallel fundamentals + risk subagents.
#              Requires TrueForge dynamic_sub_agents support.
AGENT_MODE=subagent
